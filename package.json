{
  "name": "obsidian-ledger-view",
  "version": "1.0.0",
  "description": "Ledger CLI file viewer/editor for Obsidian with VSCode-style syntax highlighting",
  "main": "main.js",
  "type": "module",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs",
    "test": "node test/run.mjs"
  },
  "keywords": [
    "obsidian",
    "ledger",
    "syntax-highlighting"
  ],
  "license": "MIT",
  "overrides": {
    "@codemirror/state": "6.5.0"
  },
  "devDependencies": {
    "@codemirror/commands": "^6.8.0",
    "@codemirror/state": "6.5.0",
    "@codemirror/view": "6.38.6",
    "@types/node": "^22.0.0",
    "builtin-modules": "^4.0.0",
    "esbuild": "^0.24.0",
    "obsidian": "1.13.1",
    "typescript": "^5.6.0"
  }
}
